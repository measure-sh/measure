{
  "comment": "Cases for the filter expression grammar, read by parse_test.go here and by frontend/dashboard/__tests__/components/filter_bar/parse_test.ts. The two parsers are separate implementations of one grammar, so a change to one of them fails.",

  "parse": [
    {
      "name": "one condition with one value",
      "text": "version_name:in:1.2.0",
      "tree": {
        "condition": {
          "key_name": "version_name",
          "operator": "in",
          "values": [{ "text": "1.2.0" }]
        }
      }
    },
    {
      "name": "one condition with a list of values",
      "text": "version_name:in:[1.2.0,1.1.9]",
      "tree": {
        "condition": {
          "key_name": "version_name",
          "operator": "in",
          "values": [{ "text": "1.2.0" }, { "text": "1.1.9" }]
        }
      }
    },
    {
      "name": "a list of one, which a list of many can be edited down to",
      "text": "version_name:in:[1.2.0]",
      "tree": {
        "condition": {
          "key_name": "version_name",
          "operator": "in",
          "values": [{ "text": "1.2.0" }]
        }
      }
    },
    {
      "name": "an operator taking no values",
      "text": "patch_id:is_set",
      "tree": {
        "condition": { "key_name": "patch_id", "operator": "is_set" }
      }
    },
    {
      "name": "conditions joined by and",
      "text": "version_name:in:1.2.0 AND mapping_type:in:dsym",
      "tree": {
        "logical_operator": "and",
        "children": [
          {
            "condition": {
              "key_name": "version_name",
              "operator": "in",
              "values": [{ "text": "1.2.0" }]
            }
          },
          {
            "condition": {
              "key_name": "mapping_type",
              "operator": "in",
              "values": [{ "text": "dsym" }]
            }
          }
        ]
      }
    },
    {
      "name": "conditions joined by or",
      "text": "version_name:in:1.2.0 OR patch_id:is_set",
      "tree": {
        "logical_operator": "or",
        "children": [
          {
            "condition": {
              "key_name": "version_name",
              "operator": "in",
              "values": [{ "text": "1.2.0" }]
            }
          },
          { "condition": { "key_name": "patch_id", "operator": "is_set" } }
        ]
      }
    },
    {
      "name": "and binds tighter than or",
      "text": "a:in:1 AND b:in:2 OR c:in:3",
      "tree": {
        "logical_operator": "or",
        "children": [
          {
            "logical_operator": "and",
            "children": [
              {
                "condition": {
                  "key_name": "a",
                  "operator": "in",
                  "values": [{ "text": "1" }]
                }
              },
              {
                "condition": {
                  "key_name": "b",
                  "operator": "in",
                  "values": [{ "text": "2" }]
                }
              }
            ]
          },
          {
            "condition": {
              "key_name": "c",
              "operator": "in",
              "values": [{ "text": "3" }]
            }
          }
        ]
      }
    },
    {
      "name": "parentheses group against that",
      "text": "a:in:1 AND (b:in:2 OR c:in:3)",
      "tree": {
        "logical_operator": "and",
        "children": [
          {
            "condition": {
              "key_name": "a",
              "operator": "in",
              "values": [{ "text": "1" }]
            }
          },
          {
            "logical_operator": "or",
            "children": [
              {
                "condition": {
                  "key_name": "b",
                  "operator": "in",
                  "values": [{ "text": "2" }]
                }
              },
              {
                "condition": {
                  "key_name": "c",
                  "operator": "in",
                  "values": [{ "text": "3" }]
                }
              }
            ]
          }
        ]
      }
    },
    {
      "name": "parentheses around one condition are still a group",
      "text": "(version_name:in:1.2.0)",
      "tree": {
        "logical_operator": "and",
        "children": [
          {
            "condition": {
              "key_name": "version_name",
              "operator": "in",
              "values": [{ "text": "1.2.0" }]
            }
          }
        ]
      }
    },
    {
      "name": "a run of one with no parentheses is that one",
      "text": "version_name:in:1.2.0",
      "tree": {
        "condition": {
          "key_name": "version_name",
          "operator": "in",
          "values": [{ "text": "1.2.0" }]
        }
      }
    },
    {
      "name": "keywords are read whatever their case",
      "text": "a:in:1 and b:in:2 or c:in:3",
      "tree": {
        "logical_operator": "or",
        "children": [
          {
            "logical_operator": "and",
            "children": [
              {
                "condition": {
                  "key_name": "a",
                  "operator": "in",
                  "values": [{ "text": "1" }]
                }
              },
              {
                "condition": {
                  "key_name": "b",
                  "operator": "in",
                  "values": [{ "text": "2" }]
                }
              }
            ]
          },
          {
            "condition": {
              "key_name": "c",
              "operator": "in",
              "values": [{ "text": "3" }]
            }
          }
        ]
      }
    },
    {
      "name": "a value starting with a keyword is a value",
      "text": "version_name:in:android",
      "tree": {
        "condition": {
          "key_name": "version_name",
          "operator": "in",
          "values": [{ "text": "android" }]
        }
      }
    },
    {
      "name": "punctuation inside a version needs no quotes",
      "text": "version_name:in:0.11.0-SNAPSHOT.debug",
      "tree": {
        "condition": {
          "key_name": "version_name",
          "operator": "in",
          "values": [{ "text": "0.11.0-SNAPSHOT.debug" }]
        }
      }
    },
    {
      "name": "a quoted value holds spaces and punctuation",
      "text": "version_name:in:\"1.2.0 (beta), rc\"",
      "tree": {
        "condition": {
          "key_name": "version_name",
          "operator": "in",
          "values": [{ "text": "1.2.0 (beta), rc" }]
        }
      }
    },
    {
      "name": "a quoted value holds an escaped quote",
      "text": "version_name:in:\"say \\\"hi\\\"\"",
      "tree": {
        "condition": {
          "key_name": "version_name",
          "operator": "in",
          "values": [{ "text": "say \"hi\"" }]
        }
      }
    },
    {
      "name": "a quoted value holds an escaped backslash",
      "text": "version_name:in:\"back\\\\slash\"",
      "tree": {
        "condition": {
          "key_name": "version_name",
          "operator": "in",
          "values": [{ "text": "back\\slash" }]
        }
      }
    },
    {
      "name": "spacing is free",
      "text": "  version_name:in:[ 1.2.0 , 1.1.9 ]   AND   patch_id:is_set  ",
      "tree": {
        "logical_operator": "and",
        "children": [
          {
            "condition": {
              "key_name": "version_name",
              "operator": "in",
              "values": [{ "text": "1.2.0" }, { "text": "1.1.9" }]
            }
          },
          { "condition": { "key_name": "patch_id", "operator": "is_set" } }
        ]
      }
    },
    {
      "name": "the same key twice, which is how a range is written",
      "text": "file_size:gt:1000 AND file_size:lt:9000",
      "tree": {
        "logical_operator": "and",
        "children": [
          {
            "condition": {
              "key_name": "file_size",
              "operator": "gt",
              "values": [{ "text": "1000" }]
            }
          },
          {
            "condition": {
              "key_name": "file_size",
              "operator": "lt",
              "values": [{ "text": "9000" }]
            }
          }
        ]
      }
    },
    {
      "name": "a group nested in a group",
      "text": "a:in:1 AND (b:in:2 OR (c:in:3 AND d:in:4))",
      "tree": {
        "logical_operator": "and",
        "children": [
          {
            "condition": {
              "key_name": "a",
              "operator": "in",
              "values": [{ "text": "1" }]
            }
          },
          {
            "logical_operator": "or",
            "children": [
              {
                "condition": {
                  "key_name": "b",
                  "operator": "in",
                  "values": [{ "text": "2" }]
                }
              },
              {
                "logical_operator": "and",
                "children": [
                  {
                    "condition": {
                      "key_name": "c",
                      "operator": "in",
                      "values": [{ "text": "3" }]
                    }
                  },
                  {
                    "condition": {
                      "key_name": "d",
                      "operator": "in",
                      "values": [{ "text": "4" }]
                    }
                  }
                ]
              }
            ]
          }
        ]
      }
    }
