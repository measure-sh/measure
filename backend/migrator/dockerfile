ARG TARGETTYPE=production
# build stage
FROM --platform=$BUILDPLATFORM public.ecr.aws/docker/library/golang:1.27-alpine AS builder
ARG TARGETOS
ARG TARGETARCH
ARG TARGETTYPE
WORKDIR /go/src

# Copy dependency modules first for caching
COPY --from=libs go.mod go.sum ../libs/
COPY ["go.mod", "go.sum", "./"]
RUN go mod download

# Copy source
COPY --from=libs . ../libs/
COPY . .

RUN --mount=type=cache,target=/go/pkg/mod \
  --mount=type=cache,target=/root/.cache/go-build \
  if [ "$TARGETTYPE" = "debug" ]; then \
  CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} \
  go build -o /go/bin/app -v .; \
  else \
  CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} \
  go build -ldflags="-s -w" -o /go/bin/app -v .; \
  fi

# runs as root: the existing migrator-volume is root-owned
# final stage: distroless; TARGETTYPE=debug adds a busybox shell
FROM gcr.io/distroless/static-debian13:latest@sha256:448810357cc8e67b7208988abdba0f5ec3d3aebee0a5b13eb624979792cffc0f AS runtime-production
FROM gcr.io/distroless/static-debian13:debug@sha256:63b4c0065ff7bd68753510400b2d5cedd5d5571d15eac4be0b6b0dd236a2d148 AS runtime-debug
FROM runtime-${TARGETTYPE}
COPY --from=builder /go/bin/app /app
ENTRYPOINT ["/app"]
